#!/usr/bin/env python3
"""pressure-run: run one scenario headless under Claude Code and Codex.

Usage: pressure-run --scenario FILE [--skill NAME] [--principle NAME]...
       [--expect-command REGEX]... [--tool claude|codex|both] [--write] [--red]
       --out DIR [--dry-run]

Makes a scratch directory per tool (under the system temp dir), exposes the
worktree skill there (not with --red), runs the scenario, and saves
DIR/<tool>.jsonl (transcript) and DIR/<tool>.txt (final answer).
GREEN passes, per tool, when the skill loaded, each --principle file was read
and, when any --principle is given, the answer has a "Principles applied:"
line. Each --expect-command REGEX must match a shell command that ran: a
tool call with its result (any exit code), not text that claims a run.
With --red the skill is not exposed and no check runs; the transcripts are
only saved. A setup error in one tool does not hide the other tool's line.
Exit 0 pass, 1 fail, 2 setup error.

Other modules import skill_loaded(events, tool) and files_read(events, tool).
"""

import argparse
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import tomllib
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
SKILLS_DIR = ROOT / "ai" / "skills"
TOOLS = ("claude", "codex")
DEFAULT_BUDGET = 0.5
RUN_TIMEOUT = 900

SKILL_PATH_RE = re.compile(r"/([\w.-]+)/SKILL\.md$")
SKILL_CMD_RE = re.compile(r"skills/([\w.-]+)/SKILL\.md")
PRINCIPLE_RE = re.compile(r"principles/([\w.-]+)\.md")
LINE_RE = re.compile(r"(?im)^[\s>*_`-]*Principles applied:[*_`\s]*\S")


class SetupError(Exception):
    pass


def load_events(path):
    """Read a JSONL transcript, skipping lines that are not JSON."""
    events = []
    for line in Path(path).read_text(encoding="utf-8").splitlines():
        try:
            item = json.loads(line)
        except ValueError:
            continue
        if isinstance(item, dict):
            events.append(item)
    return events


def _claude_tool_uses(events):
    for event in events:
        if event.get("type") != "assistant":
            continue
        content = (event.get("message") or {}).get("content")
        if not isinstance(content, list):
            continue
        for item in content:
            if isinstance(item, dict) and item.get("type") == "tool_use":
                yield item


READERS = {"cat", "head", "tail", "sed", "nl", "less", "bat", "awk"}


def _claude_error_ids(events):
    """Map each tool_use id whose tool_result came back with is_error to its result text."""
    ids = {}
    for event in events:
        if event.get("type") != "user":
            continue
        content = (event.get("message") or {}).get("content")
        if not isinstance(content, list):
            continue
        for item in content:
            if isinstance(item, dict) and item.get("type") == "tool_result" and item.get("is_error"):
                text = item.get("content")
                if isinstance(text, list):
                    text = "\n".join(b.get("text", "") for b in text if isinstance(b, dict))
                ids[item.get("tool_use_id")] = text if isinstance(text, str) else ""
    return ids


def _expand_braces(token):
    """Expand shell brace lists: `p/{a,b}.md` -> [`p/a.md`, `p/b.md`]."""
    m = re.search(r"\{([^{}]*,[^{}]*)\}", token)
    if not m:
        return [token]
    out = []
    for part in m.group(1).split(","):
        out.extend(_expand_braces(token[:m.start()] + part + token[m.end():]))
    return out


def _codex_read_paths(command):
    """Return path tokens of a command that is a plain reader (cat, head, ...).

    Looks inside a `zsh -lc '...'` wrapper and checks each segment split on
    && || ; | and newlines. Brace lists are expanded. Returns [] when no
    segment starts with a reader (ls, grep, rg, find, test, stat, ...).
    """
    payload = command
    try:
        tokens = shlex.split(command)
    except ValueError:
        return []
    if len(tokens) >= 3 and tokens[1] in ("-c", "-lc", "-ic", "-l", "-i"):
        payload = tokens[-1]
    # Split into segments on && || ; | and newlines (punctuation_chars splits them
    # when glued to a word; newline is removed from whitespace so it separates).
    try:
        lex = shlex.shlex(payload, posix=True, punctuation_chars=";&|\n")
        lex.whitespace = " \t\r"
        lex.whitespace_split = True
        words = list(lex)
    except ValueError:
        return []
    paths = []
    segment = []
    for word in words + [";"]:
        if word and set(word) <= set(";&|\n"):
            if segment and Path(segment[0]).name in READERS:
                for t in segment[1:]:
                    if "/" in t:
                        paths.extend(_expand_braces(t))
            segment = []
        else:
            segment.append(word)
    return paths


FAILED_LINE = re.compile(r"^(?:[\w.-]+: )?(?:cannot (?:access|open) )?['\"]?(.+?)['\"]?: "
                         r"(?:No such file or directory|Permission denied|Is a directory)")


def _reads_despite_failure(command, output):
    """Reader paths of a failed command that its output does not name as failed.

    A command can exit non-zero because a later part failed (`cat a; ls nope`).
    Count a path only when the output names each failed file; a failure that
    names no file counts nothing.
    """
    failed = {Path(m.group(1)).name for m in map(FAILED_LINE.match, (output or "").splitlines()) if m}
    if not failed:
        return []
    return [p for p in _codex_read_paths(command) if Path(p).name not in failed]


def _codex_reads(events):
    """Yield reader path tokens of completed commands.

    Exit 0 counts every reader path. A non-zero exit counts the paths that the
    output does not name as failed.
    """
    for event in events:
        item = event.get("item")
        if event.get("type") != "item.completed" or not isinstance(item, dict) \
                or item.get("type") != "command_execution" or not isinstance(item.get("command"), str):
            continue
        if item.get("exit_code") == 0:
            yield from _codex_read_paths(item["command"])
        elif item.get("exit_code") is not None:
            yield from _reads_despite_failure(item["command"], item.get("aggregated_output"))


def _claude_result_ids(events):
    """Return the tool_use ids that have a tool_result (error or not)."""
    ids = set()
    for event in events:
        if event.get("type") != "user":
            continue
        content = (event.get("message") or {}).get("content")
        if not isinstance(content, list):
            continue
        for item in content:
            if isinstance(item, dict) and item.get("type") == "tool_result":
                ids.add(item.get("tool_use_id"))
    return ids


def commands_run(events, tool):
    """Return the shell commands that ran, with any exit code.

    Claude: the command of each Bash tool_use that has a tool_result.
    Codex: the command of each completed command_execution with an exit code.
    A command in answer text, a call with no result, or a started item does not count.
    """
    found = []
    if tool == "claude":
        done = _claude_result_ids(events)
        for use in _claude_tool_uses(events):
            command = (use.get("input") or {}).get("command")
            if use.get("name") == "Bash" and isinstance(command, str) and use.get("id") in done:
                found.append(command)
    elif tool == "codex":
        for event in events:
            item = event.get("item")
            if event.get("type") == "item.completed" and isinstance(item, dict) \
                    and item.get("type") == "command_execution" and isinstance(item.get("command"), str) \
                    and item.get("exit_code") is not None:
                found.append(item["command"])
    else:
        raise ValueError(f"unknown tool: {tool}")
    return found


def files_read(events, tool):
    """Return the set of file paths the run read successfully.

    Claude: the file_path of each Read tool_use, and the reader path tokens of
    each Bash tool_use, whose tool_result is not an error. A failed Bash call
    counts the paths its output does not name as failed. Sub-agent events
    count too (parent_tool_use_id is not checked).
    Codex: path tokens (with a "/") of each completed reader segment (cat, head,
    tail, sed, nl, less, bat, awk). A non-zero exit counts the paths its output
    does not name as failed.
    """
    found = set()
    if tool == "claude":
        bad = _claude_error_ids(events)
        for use in _claude_tool_uses(events):
            path = (use.get("input") or {}).get("file_path")
            command = (use.get("input") or {}).get("command")
            if use.get("id") in bad:
                if use.get("name") == "Bash" and isinstance(command, str):
                    found.update(_reads_despite_failure(command, bad[use.get("id")]))
                continue
            if use.get("name") == "Read" and isinstance(path, str):
                found.add(path)
            if use.get("name") == "Bash" and isinstance(command, str):
                found.update(_codex_read_paths(command))
    elif tool == "codex":
        found.update(_codex_reads(events))
    else:
        raise ValueError(f"unknown tool: {tool}")
    return found


def skill_loaded(events, tool):
    """Return the set of skill names the run loaded."""
    names = set()
    if tool == "claude":
        for use in _claude_tool_uses(events):
            if use.get("name") == "Skill":
                name = (use.get("input") or {}).get("skill")
                if isinstance(name, str):
                    names.add(name)
        for path in files_read(events, "claude"):
            match = SKILL_PATH_RE.search(path)
            if match:
                names.add(match.group(1))
    elif tool == "codex":
        for path in files_read(events, "codex"):
            names.update(SKILL_CMD_RE.findall(path))
    else:
        raise ValueError(f"unknown tool: {tool}")
    return names


def principles_read(events, tool):
    """Return the set of principle names the run read."""
    names = set()
    for path in files_read(events, tool):
        names.update(PRINCIPLE_RE.findall(path))
    return names


def final_answer(events, tool):
    """Return the last answer text of the run ('' when there is none)."""
    if tool == "claude":
        for event in reversed(events):
            if event.get("type") == "result" and isinstance(event.get("result"), str):
                return event["result"]
        return ""
    if tool == "codex":
        for event in reversed(events):
            item = event.get("item")
            if event.get("type") == "item.completed" and isinstance(item, dict) \
                    and item.get("type") == "agent_message":
                return item.get("text") or ""
        return ""
    raise ValueError(f"unknown tool: {tool}")


def run_error(events, tool):
    """Return the real cause when the run itself failed (None when it finished)."""
    if tool == "claude":
        for event in reversed(events):
            if event.get("type") == "result":
                if event.get("is_error") or event.get("subtype", "success") != "success":
                    return f"claude run ended with {event.get('subtype') or 'error'}: {str(event.get('result') or '')[:200]}"
                return None
        return "claude run has no result event"
    if tool == "codex":
        for event in events:
            if event.get("type") in ("turn.failed", "error"):
                return f"codex run failed: {json.dumps(event)[:200]}"
        if not any(e.get("type") == "turn.completed" for e in events):
            return "codex run has no turn.completed event"
        return None
    raise ValueError(f"unknown tool: {tool}")


def check(tool, events, skill, principles, expect=()):
    """Return a list of failure messages (empty list means pass)."""
    failures = []
    ran = commands_run(events, tool) if expect else []
    for pattern in expect:
        if not any(re.search(pattern, command) for command in ran):
            failures.append(f"expected command not run: {pattern}")
    if skill and skill not in skill_loaded(events, tool):
        failures.append(f"skill not loaded: {skill}")
    read = principles_read(events, tool)
    for name in principles:
        if name not in read:
            failures.append(f"principle not read: {name}")
    if principles and not LINE_RE.search(final_answer(events, tool)):
        failures.append("answer has no 'Principles applied:' line")
    return failures


def claude_command(prompt, write=False, budget=DEFAULT_BUDGET, sources="project"):
    # --setting-sources project: a user-level skill with the same name would win
    # over the project one (probe 2026-10-30), so user settings stay out of the run.
    return [
        "claude", "-p", prompt,
        "--output-format", "stream-json", "--verbose",
        "--permission-mode", "acceptEdits" if write else "plan",
        "--setting-sources", sources,
        "--max-budget-usd", str(budget),
        # No MCP server in a run: a scenario must not reach a prod system
        # (8.2 green-4 queried prod Metabase). Also drops claude.ai connectors.
        "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
    ]


def codex_config():
    """The Codex config file: $CODEX_HOME/config.toml, else ~/.codex/config.toml."""
    home = os.environ.get("CODEX_HOME")
    return Path(home or Path.home() / ".codex") / "config.toml"


def codex_mcp_off(config=None):
    """-c flags that disable each MCP server in the Codex config, and the apps connectors.
    -c mcp_servers={} merges and leaves the servers on (probe 2026-10-30)."""
    try:
        servers = tomllib.loads(Path(config or codex_config()).read_text()).get("mcp_servers", {})
    except (OSError, tomllib.TOMLDecodeError):
        servers = {}
    flags = []
    for name in sorted(servers):
        # A name with a dot or other non-bare character must be a quoted TOML key.
        key = name if re.fullmatch(r"[A-Za-z0-9_-]+", name) else json.dumps(name)
        flags += ["-c", f"mcp_servers.{key}.enabled=false"]
    return flags + ["-c", "features.apps=false"]


def codex_command(prompt, cwd, write=False, config=None):
    return [
        "codex", "exec", "--json", "--skip-git-repo-check",
        "-s", "workspace-write" if write else "read-only",
        *codex_mcp_off(config),
        "-C", str(cwd), prompt,
    ]


def build_command(tool, prompt, cwd, write, budget, sources="project"):
    if tool == "claude":
        return claude_command(prompt, write, budget, sources)
    return codex_command(prompt, cwd, write)


def prepare_scratch(tool, skill, red):
    """Make the scratch dir and link the worktree skill into it."""
    scratch = Path(tempfile.mkdtemp(prefix=f"pressure-{tool}-"))
    # The router is present in every run, GREEN and RED.
    shutil.copyfile(ROOT / "ai" / "AGENTS.md", scratch / "AGENTS.md")
    (scratch / "CLAUDE.md").write_text("@AGENTS.md\n", encoding="utf-8")
    if skill and not red:
        base = ".claude" if tool == "claude" else ".agents"
        link = scratch / base / "skills" / skill
        link.parent.mkdir(parents=True)
        link.symlink_to(SKILLS_DIR / skill)
    return scratch


def red_note(skill, home=None):
    """Return user-level skill paths of the same name that RED would still see."""
    home = Path(home) if home else Path.home()
    paths = [home / ".agents" / "skills" / skill, home / ".claude" / "skills" / skill]
    return [p for p in paths if p.is_symlink() or p.exists()]


def kill_group(proc):
    """TERM the process group, wait 5 s for the leader, then KILL the group."""
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        pass
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    proc.wait()


def run_tool(tool, prompt, args):
    if shutil.which(tool) is None:
        raise SetupError(f"{tool} not found on PATH")
    scratch = prepare_scratch(tool, args.skill, args.red)
    cmd = build_command(tool, prompt, scratch, args.write, args.budget, args.setting_sources)
    out = Path(args.out)
    proc = None
    try:
        # Own session: a timeout or exit kills the whole group, so no child
        # (shell command, node worker) lives on as an orphan.
        proc = subprocess.Popen(cmd, cwd=scratch, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True, start_new_session=True)
        try:
            stdout, stderr = proc.communicate(timeout=RUN_TIMEOUT)
        except subprocess.TimeoutExpired:
            kill_group(proc)
            stdout, _ = proc.communicate()
            (out / f"{tool}.jsonl").write_text(stdout or "", encoding="utf-8")
            raise SetupError(f"{tool} run timed out after {RUN_TIMEOUT}s")
        returncode = proc.returncode
    except OSError as exc:
        raise SetupError(f"{tool} did not start: {exc}") from exc
    finally:
        if proc is not None:
            kill_group(proc)
        shutil.rmtree(scratch, ignore_errors=True)
    (out / f"{tool}.jsonl").write_text(stdout, encoding="utf-8")
    events = []
    for line in stdout.splitlines():
        try:
            item = json.loads(line)
        except ValueError:
            continue
        if isinstance(item, dict):
            events.append(item)
    (out / f"{tool}.txt").write_text(final_answer(events, tool), encoding="utf-8")
    cause = run_error(events, tool)
    if cause:
        raise SetupError(cause)
    if returncode != 0:
        raise SetupError(f"{tool} exited {returncode}: {stderr.strip()[-300:]}")
    return events


def parse_args(argv):
    p = argparse.ArgumentParser(prog="pressure-run", description=__doc__.split("\n\n")[0])
    p.add_argument("--scenario", required=True, help="file with the scenario prompt")
    p.add_argument("--skill", help="skill under test (ai/skills/<name>)")
    p.add_argument("--principle", action="append", default=[], help="principle that must be read (repeatable)")
    p.add_argument("--expect-command", action="append", default=[], metavar="REGEX",
                   help="a shell command that ran must match REGEX (repeatable)")
    p.add_argument("--tool", choices=["claude", "codex", "both"], default="both")
    p.add_argument("--write", action="store_true", help="let the run edit files in the scratch dir")
    p.add_argument("--red", action="store_true", help="do not expose the skill; save transcripts only")
    p.add_argument("--out", required=True, help="directory for <tool>.jsonl and <tool>.txt")
    p.add_argument("--dry-run", action="store_true", help="print the commands and exit")
    p.add_argument("--setting-sources", default="project", help="Claude --setting-sources (default project)")
    p.add_argument("--budget", type=float, default=DEFAULT_BUDGET, help="Claude --max-budget-usd")
    return p.parse_args(argv)


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        scenario = Path(args.scenario)
        if not scenario.is_file():
            raise SetupError(f"scenario not found: {scenario}")
        if args.skill and not args.red and not args.dry_run and not (SKILLS_DIR / args.skill / "SKILL.md").is_file():
            raise SetupError(f"skill not found: {SKILLS_DIR / args.skill}/SKILL.md")
        for pattern in args.expect_command:
            try:
                re.compile(pattern)
            except re.error as exc:
                raise SetupError(f"bad --expect-command {pattern!r}: {exc}")
        prompt = scenario.read_text(encoding="utf-8").strip()
        tools = TOOLS if args.tool == "both" else (args.tool,)

        if args.dry_run:
            for tool in tools:
                cwd = f"<scratch>/{tool}"
                print(f"{tool}: " + shlex.join(build_command(tool, prompt, cwd, args.write, args.budget, args.setting_sources)))
            return 0

        Path(args.out).mkdir(parents=True, exist_ok=True)
        if args.red and args.skill:
            visible = red_note(args.skill)
            if visible:
                note = ("RED baseline is today's setup without the new skill. "
                        "A user-level skill of the same name is visible: "
                        + ", ".join(str(v) for v in visible) + "\n")
                print("pressure-run: warning: " + note, end="", file=sys.stderr)
                (Path(args.out) / "red-note.txt").write_text(note, encoding="utf-8")
        status = 0
        # The CLIs run at the same time; each has its own scratch dir and output files.
        with ThreadPoolExecutor(max_workers=len(tools)) as pool:
            futures = [(tool, pool.submit(run_tool, tool, prompt, args)) for tool in tools]
        for tool, future in futures:
            try:
                events = future.result()
            except SetupError as exc:
                # Keep the loop: the other tool's line still prints.
                status = 2
                print(f"{tool}: SETUP ERROR {exc}")
                print(f"pressure-run: {exc}", file=sys.stderr)
                continue
            if args.red:
                print(f"{tool}: saved (red, no checks)")
                continue
            failures = check(tool, events, args.skill, args.principle, args.expect_command)
            if failures:
                status = max(status, 1)
                print(f"{tool}: FAIL")
                for failure in failures:
                    print(f"  - {failure}")
            else:
                print(f"{tool}: PASS")
        return status
    except SetupError as exc:
        print(f"pressure-run: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
