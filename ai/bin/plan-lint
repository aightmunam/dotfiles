#!/usr/bin/env bash
# plan-lint FILE...: run Grimoire's plan parser on each file and print every
# warning as "FILE: warning". A file that does not start with a kind: plan
# manifest is a warning too. It also checks each "- [ ] **Step N: ...**"
# item: a test step names a test and a literal expected value, and a code step
# names a signature and a file path (see the usage text).
# Exit 0 clean, 1 on any warning, 2 on setup error.
# GRIMOIRE_DIR overrides the Grimoire checkout (default ~/Developer/grimoire).
set -u

usage() {
  cat <<'USAGE'
usage: plan-lint FILE...
Run Grimoire's plan parser on each FILE and print every warning as
"FILE: warning". A file that does not start with a kind: plan manifest
is a warning too.

Step rule, for each "- [ ] **Step N: <title>**" item and each other
"- [ ] " item, with its indented and fenced lines. The title of an item
without the Step label is its first sentence.
Kind of each item, by title first and then by content:
- An item is not checked when its title starts with a backtick or with Run,
  Commit, Record, Confirm, Inspect, Check or Read. An item is also not
  checked when its title states a result (exit, exits, pass, passes) and
  does not start with Write, Add or Implement.
- A test step has a title that starts with Write or Add and names a test,
  or it has the word test or tests in its title (not test cards or test
  harness), or it has a sentence that starts with Test.
- A code step has a title that starts with Implement, or it names a source
  file in backticks (.py .sh .js .ts .go .rs .nix) or has a fenced def,
  func or class. An Implement step that names only other files, such as
  .md, is a prose edit and is not checked.
Checks:
- A test step needs a test name in backticks (test_x, TestX, x_test, a::b)
  and a literal expected value: a backticked value with a digit, a quote or
  True/False/None, a backticked value after assert, expect, equal, contain,
  print, return or raise, or an assert line in a fenced block.
- A code step needs a signature in backticks or in a fenced block, as
  name(params) -> type, name(params): type, or func name(params) type, and
  a file path in backticks.

Exit 0 clean, 1 on any warning, 2 on setup error.
GRIMOIRE_DIR overrides the Grimoire checkout (default ~/Developer/grimoire).
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

if [ "$#" -eq 0 ]; then
  echo "usage: plan-lint FILE..." >&2
  exit 2
fi

for f in "$@"; do
  if [ ! -f "$f" ]; then
    echo "plan-lint: input file not found: $f" >&2
    exit 2
  fi
done

grimoire="${GRIMOIRE_DIR:-$HOME/Developer/grimoire}"
py="$grimoire/.venv/bin/python"
if [ ! -x "$py" ]; then
  echo "plan-lint: Grimoire venv python not found: $py (set GRIMOIRE_DIR)" >&2
  exit 2
fi

PYTHONPATH="$grimoire" exec "$py" -c '
import re
import sys
from pathlib import Path

STEP = re.compile(r"^- \[[ xX]\] \*\*Step (\d+):?(.*)$")
BARE = re.compile(r"^- \[[ xX]\] (?!\*\*Step )(.*)$")
BOLD_END = re.compile(r"^(.*?)\*\*(.*)$")
TICKS = re.compile(r"`([^`\n]+)`")
TEST_WORD = re.compile(r"\btests?\b(?!\s+(cards?|harness\w*)\b)", re.I)
TEST_STEP = re.compile(r"^(write|add)\b", re.I)
CODE_STEP = re.compile(r"^implement\b", re.I)
NOT_CODE = re.compile(r"^(run|commit|record|confirm|inspect|check|read)\b", re.I)
SOURCE = re.compile(r"\.(py|sh|js|ts|go|rs|nix)$")
FENCE_DEF = re.compile(r"^\s*(?:async\s+)?(def|func|class)\s")
SENTENCE_TEST = re.compile(r"(?:^|[.:]\s+)Tests?\s")
# A verification item states a result: the tests exit 0, the suite passes.
RESULT = re.compile(r"\b(exits?|pass(es)?)\b", re.I)
TEST_NAME = re.compile(r"^\S*?(?:^|::|[./])(test_\w+|Test[A-Z0-9_]\w*|\w+_test)$|^\S+::\S+$")
FENCE_TEST = re.compile(r"^\s*(?:async\s+)?(?:def|func)\s+(test_\w+|Test\w+)\s*\(")
LITERAL = re.compile(r"\d|[\x22\x27]|^(True|False|None|true|false|null|nil)$")
CUE = re.compile(r"\b(asserts?|expect(?:s|ed)?|equals?|contains?|prints?|returns?|raises?)\b[^`.;]{0,40}`[^`\n]+`", re.I)
FENCE_ASSERT = re.compile(r"\bassert|\bexpect\s*\(|\.toBe|\bt\.(Error|Fatal)")
SIGNATURE = re.compile(r"[A-Za-z_][\w.]*\s*\([^()]*\)\s*(->|:)\s*\S|\bfunc\s+(\([^()]*\)\s*)?\w+\s*\([^()]*\)\s*\S")
PATH = re.compile(r"^~?[\w.-]*(/[\w.*<>-]+)+/?$|^[\w-]+\.\w{1,6}$")


def steps(text):
    """Yield (line number, step number, title, step lines) for each step item."""
    lines = text.split("\n")
    i = 0
    while i < len(lines):
        m = STEP.match(lines[i])
        bare = None if m else BARE.match(lines[i])
        if not m and not bare:
            i += 1
            continue
        if m:
            start, label, rest = i + 1, "Step " + m.group(1), m.group(2)
            b = BOLD_END.match(rest)
            title = b.group(1).strip() if b else rest.strip()
            after = b.group(2) if b else ""
        else:
            start, label, title, after = i + 1, "checkbox step", "", bare.group(1)
        if not title:
            title = re.split(r"[.:](\s|$)", after.strip(), maxsplit=1)[0]
        body, fence = [lines[i]], False
        i += 1
        while i < len(lines):
            line = lines[i]
            if line.lstrip().startswith("```"):
                fence = not fence
            elif not fence and (line.startswith("#") or line.startswith("- [") or line.startswith("**File**")):
                break
            body.append(line)
            i += 1
        yield start, label, title, body


def fenced(body):
    out, on = [], False
    for line in body:
        if line.lstrip().startswith("```"):
            on = not on
        elif on:
            out.append(line)
    return out


def check_steps(text):
    for start, label, title, body in steps(text):
        joined = "\n".join(body)
        ticks = TICKS.findall(joined)
        code = fenced(body)
        where = f"line {start}: {label}"
        paths = [t.strip() for t in ticks if PATH.match(t.strip())]
        source = any(SOURCE.search(t) for t in paths) or any(FENCE_DEF.match(l) for l in code)
        bare_title = TICKS.sub("", title).strip()
        # A verification item starts with its command, or with Run, Check and the like.
        if NOT_CODE.match(title) or title.startswith("`"):
            kind = None
        elif TEST_STEP.match(title) and TEST_WORD.search(bare_title):
            kind = "test"
        elif CODE_STEP.match(title):
            # A prose edit (only non-source paths, such as .md) is not code.
            kind = None if paths and not source else "code"
        elif RESULT.search(title):
            kind = None
        elif TEST_WORD.search(bare_title) or SENTENCE_TEST.search(joined):
            kind = "test"
        elif source:
            kind = "code"
        else:
            kind = None
        if kind == "test":
            if not (any(TEST_NAME.match(t.strip()) for t in ticks) or any(FENCE_TEST.match(l) for l in code)):
                yield f"{where}: test step names no test in backticks"
            if not (any(LITERAL.search(t.strip()) for t in ticks) or CUE.search(joined) or any(FENCE_ASSERT.search(l) for l in code)):
                yield f"{where}: test step has no literal expected value"
        elif kind == "code":
            if not (any(SIGNATURE.search(t) for t in ticks) or any(SIGNATURE.search(l) for l in code)):
                yield f"{where}: code step has no signature name(params) -> type"
            if not any(PATH.match(t.strip()) for t in ticks):
                yield f"{where}: code step names no file path"


bad = False
for name in sys.argv[1:]:
    try:
        from app.data.plan_parser import parse_plan
        path = Path(name)
        text = path.read_text(encoding="utf-8")
        plan = parse_plan(text, path)
    except Exception as exc:
        print(f"plan-lint: internal error: {name}: {exc!r}", file=sys.stderr)
        sys.exit(2)
    # Grimoire checks the manifest only when it can read it. Without one the
    # parser gives no warnings, so a clean exit would prove nothing.
    if text.split("\n", 1)[0].rstrip("\r") != "---":
        print(f"{name}: line 1 is not ---, so the kind: plan manifest is not read")
        bad = True
    elif not plan.is_structured:
        print(f"{name}: no kind: plan manifest in the frontmatter")
        bad = True
    for warning in plan.warnings:
        print(f"{name}: {warning}")
        bad = True
    for warning in check_steps(text):
        print(f"{name}: {warning}")
        bad = True
sys.exit(1 if bad else 0)
' "$@"
