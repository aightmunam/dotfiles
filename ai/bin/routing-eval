#!/usr/bin/env python3
"""routing-eval: check that the right skill loads for a prompt, under Claude and Codex.

Usage: routing-eval [--tool claude|codex|both] [--id ID] [--skill NAME]
       [--pair NAME] [--dry-run] [--live] [--budget USD] [--out DIR] [--jobs N]

Reads ai/tests/routing/prompts.tsv (columns id, expected, pair, prompt). Each
prompt runs read-only in a scratch working directory. Default mode exposes
every directory of ai/skills there (Claude <scratch>/.claude/skills/<name>,
Codex <scratch>/.agents/skills/<name>), as pressure-run does for one skill.
--live links nothing: the CLIs use the installed user-level skills.
The runner stops each process at the first skill load or the end of the first
turn. "got" is the skill that loaded, "none" when none did, "a+b" (a miss) when
one event loaded more than one, or "error" (a miss, cause in the note column)
when a run hit its budget or timeout before a load.
Claude detection accepts a load only after its tool_result arrives without error.
Default mode links third-party skills installed in ~/.agents/skills (names not
in ai/skills) next to the repo skills. Codex also still sees the main checkout's
user-level skills in default mode, so a Codex pass there does not prove the
worktree text routed; use --live after generate.sh for that.
Results: DIR/<YYYY-MM-DD>-<tool>.tsv (id, expected, got, pass, note; a full
run replaces it, a filtered run updates its rows) and
DIR/raw/<id>-<tool>.jsonl. Default DIR is
<main checkout>/thoughts/shared/research/routing-eval.
Threshold, per tool: every row with a pair passes, and at most 1 miss in total.
Exit 0 threshold met, 1 not met, 2 setup error.
"""

import argparse
import csv
import datetime
import importlib.machinery
import importlib.util
import json
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
TSV = ROOT / "ai" / "tests" / "routing" / "prompts.tsv"


def main_checkout(root):
    """The main checkout of the repo at root. In a worktree, thoughts/ lives only there."""
    try:
        common = subprocess.run(
            ["git", "-C", str(root), "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return root
    return Path(common).parent


DEFAULT_OUT = main_checkout(ROOT) / "thoughts" / "shared" / "research" / "routing-eval"
USER_SKILLS = Path.home() / ".agents" / "skills"
# Live runs start here, not in the system temp dir. Claude skips the user
# CLAUDE.md @AGENTS.md import in an untrusted folder, so the router would be absent.
# ~/Developer is trusted and holds no CLAUDE.md, AGENTS.md or project settings.
LIVE_ROOT = Path.home() / "Developer"
DEFAULT_BUDGET = 0.30
RUN_TIMEOUT = 300
TOOLS = ("claude", "codex")
MAX_MISSES = 1


class SetupError(Exception):
    pass


def _load_pressure_run():
    path = ROOT / "ai" / "bin" / "pressure-run"
    loader = importlib.machinery.SourceFileLoader("pressure_run", str(path))
    spec = importlib.util.spec_from_loader("pressure_run", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


PR = _load_pressure_run()


def load_rows(path=TSV):
    with open(path, encoding="utf-8", newline="") as handle:
        return [dict(row) for row in csv.DictReader(handle, delimiter="\t")]


def select(rows, id=None, skill=None, pair=None):
    out = []
    for row in rows:
        if id and row["id"] != id:
            continue
        if skill and row["expected"] != skill:
            continue
        if pair and row["pair"] != pair:
            continue
        out.append(row)
    return out


def confirmed_events(events, tool):
    """Return events for detection. Claude: drop tool_use items with no tool_result
    yet, and Skill calls whose result is an error (an attempted load is not a load)."""
    if tool != "claude":
        return events
    resulted = set()
    for event in events:
        content = (event.get("message") or {}).get("content") if event.get("type") == "user" else None
        if isinstance(content, list):
            for item in content:
                if isinstance(item, dict) and item.get("type") == "tool_result":
                    resulted.add(item.get("tool_use_id"))
    bad = PR._claude_error_ids(events)
    out = []
    for event in events:
        content = (event.get("message") or {}).get("content") if event.get("type") == "assistant" else None
        if not isinstance(content, list):
            out.append(event)
            continue
        kept = [i for i in content
                if not (isinstance(i, dict) and i.get("type") == "tool_use"
                        and (i.get("id") not in resulted
                             or (i.get("name") == "Skill" and i.get("id") in bad)))]
        out.append({**event, "message": {**event["message"], "content": kept}})
    return out


def pending_tool_uses(events, tool):
    """Claude: tool_use ids that have no tool_result yet."""
    if tool != "claude":
        return set()
    ids = {u.get("id") for u in PR._claude_tool_uses(events)}
    for event in events:
        content = (event.get("message") or {}).get("content") if event.get("type") == "user" else None
        if isinstance(content, list):
            for item in content:
                if isinstance(item, dict) and item.get("type") == "tool_result":
                    ids.discard(item.get("tool_use_id"))
    return ids


def loaded_skills(events, tool):
    return PR.skill_loaded(confirmed_events(events, tool), tool)


def got_skill(events, tool, expected=None):
    """Return the skill name to record. More than one skill loaded gives "a+b" (a miss)."""
    loaded = loaded_skills(events, tool)
    if not loaded:
        return "none"
    return "+".join(sorted(loaded))


def turn_ended(event, tool):
    if tool == "claude":
        return event.get("type") == "result"
    return event.get("type") in ("turn.completed", "turn.failed")


def threshold(results):
    """Return (ok, reasons) for one tool. results: dicts with pair, pass."""
    reasons = []
    misses = [r for r in results if not r["pass"]]
    for r in misses:
        if r.get("pair"):
            reasons.append(f"pair row missed: {r['id']} (expected {r['expected']}, got {r['got']})")
    if len(misses) > MAX_MISSES:
        reasons.append(f"{len(misses)} misses, at most {MAX_MISSES} allowed")
    return (not reasons, reasons)


def third_party_skills(user_dir=None, exclude=()):
    """Installed skills to link next to the repo skills: entries of ~/.agents/skills
    with a SKILL.md, no dot entries, and a name not in exclude."""
    user_dir = Path(user_dir or USER_SKILLS)
    if not user_dir.is_dir():
        return []
    return [e for e in sorted(user_dir.iterdir())
            if not e.name.startswith(".") and e.name not in exclude and (e / "SKILL.md").is_file()]


def prepare_scratch(tool, live, user_dir=None, live_root=None):
    if live:
        return Path(tempfile.mkdtemp(prefix=f".routing-{tool}-", dir=live_root or LIVE_ROOT))
    scratch = Path(tempfile.mkdtemp(prefix=f"routing-{tool}-"))
    # The router is present in every run, as in pressure-run.
    shutil.copyfile(ROOT / "ai" / "AGENTS.md", scratch / "AGENTS.md")
    (scratch / "CLAUDE.md").write_text("@AGENTS.md\n", encoding="utf-8")
    base = ".claude" if tool == "claude" else ".agents"
    target = scratch / base / "skills"
    target.mkdir(parents=True)
    names = set()
    for skill in sorted(PR.SKILLS_DIR.iterdir()):
        if skill.is_dir():
            (target / skill.name).symlink_to(skill)
            names.add(skill.name)
    for entry in third_party_skills(user_dir, names):
        (target / entry.name).symlink_to(entry.resolve())
    return scratch


def build_command(tool, prompt, cwd, budget, live):
    return PR.build_command(tool, prompt, cwd, False, budget, "user,project" if live else "project")


RUNNING = set()
RUNNING_LOCK = threading.Lock()


kill_group = PR.kill_group


def kill_all():
    with RUNNING_LOCK:
        procs = list(RUNNING)
    for proc in procs:
        kill_group(proc)


AUTH_RE = re.compile(r"(?i)\b(auth|login|log in|api key|401|403|unauthori[sz]ed|credential)")


def run_row(tool, row, args):
    """Run one prompt. Return (events, raw_text, note). Stops at the first skill load
    (Claude: its tool_result without error) or the end of the first turn.
    note is "" or the cause of a budget stop or timeout that left no load."""
    if shutil.which(tool) is None:
        raise SetupError(f"{tool} not found on PATH")
    scratch = prepare_scratch(tool, args.live)
    cmd = build_command(tool, row["prompt"], scratch, args.budget, args.live)
    lines, events = [], []
    timed_out = []
    errfile = tempfile.TemporaryFile(mode="w+", encoding="utf-8")
    try:
        proc = subprocess.Popen(cmd, cwd=scratch, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=errfile, text=True, start_new_session=True)
    except OSError as exc:
        errfile.close()
        shutil.rmtree(scratch, ignore_errors=True)
        raise SetupError(f"{tool} did not start: {exc}") from exc
    with RUNNING_LOCK:
        RUNNING.add(proc)

    def on_timeout():
        timed_out.append(True)
        kill_group(proc)

    timer = threading.Timer(RUN_TIMEOUT, on_timeout)
    timer.start()
    detected = False
    try:
        for line in proc.stdout:
            lines.append(line)
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if not isinstance(event, dict):
                continue
            events.append(event)
            if loaded_skills(events, tool) and not pending_tool_uses(events, tool):
                detected = True
                break
            if turn_ended(event, tool):
                break
    finally:
        timer.cancel()
        kill_group(proc)
        with RUNNING_LOCK:
            RUNNING.discard(proc)
        errfile.seek(0)
        stderr = errfile.read()
        errfile.close()
        proc.stdout.close()
        shutil.rmtree(scratch, ignore_errors=True)
    raw = "".join(lines)
    if detected or loaded_skills(events, tool):
        return events, raw, ""
    if timed_out:
        return events, raw, f"timed out after {RUN_TIMEOUT}s"
    if not events:
        raise SetupError(f"{row['id']} {tool}: no events. {stderr.strip()[-200:]}")
    cause = PR.run_error(events, tool)
    if cause:
        if AUTH_RE.search(cause):
            raise SetupError(f"{row['id']} {tool}: {cause}")
        return events, raw, cause
    return events, raw, ""


COLUMNS = ["id", "expected", "got", "pass", "note"]


def write_results(out, tool, results, date, merge=False):
    """Write {date}-{tool}.tsv. merge=True (a filtered rerun: --id, --skill, --pair)
    updates its rows and keeps the others. merge=False (a full run) replaces the
    file, so the ids of an old run do not stay."""
    out.mkdir(parents=True, exist_ok=True)
    path = out / f"{date}-{tool}.tsv"
    rows = {}
    if merge and path.exists():
        with open(path, encoding="utf-8", newline="") as handle:
            for row in csv.DictReader(handle, delimiter="\t"):
                if row.get("id"):
                    # An old file can lack a column (note): fill it with "".
                    rows[row["id"]] = {col: row.get(col) or "" for col in COLUMNS}
    for r in results:
        rows[r["id"]] = {"id": r["id"], "expected": r["expected"], "got": r["got"],
                         "pass": "yes" if r["pass"] else "no", "note": r.get("note", "")}
    with open(path, "w", encoding="utf-8", newline="") as handle:
        writer = csv.writer(handle, delimiter="\t", lineterminator="\n")
        writer.writerow(COLUMNS)
        for row in rows.values():
            writer.writerow([row[col] for col in COLUMNS])


def parse_args(argv):
    p = argparse.ArgumentParser(prog="routing-eval", description=__doc__.split("\n\n")[0])
    p.add_argument("--tool", choices=["claude", "codex", "both"], default="both")
    p.add_argument("--id", help="run one row by id")
    p.add_argument("--skill", help="run the rows whose expected skill is NAME")
    p.add_argument("--pair", help="run the rows of one tie-break set, e.g. staging/data-op")
    p.add_argument("--dry-run", action="store_true", help="print the commands and exit")
    p.add_argument("--live", action="store_true", help="no scratch links; use the installed user-level skills")
    p.add_argument("--budget", type=float, default=DEFAULT_BUDGET, help="Claude --max-budget-usd per prompt")
    p.add_argument("--out", default=str(DEFAULT_OUT), help="results directory")
    p.add_argument("--jobs", type=int, default=4, help="prompts run at the same time")
    return p.parse_args(argv)


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        rows = select(load_rows(), args.id, args.skill, args.pair)
        if not rows:
            raise SetupError("no row matches the filters")
        tools = TOOLS if args.tool == "both" else (args.tool,)
        if args.dry_run:
            for row in rows:
                for tool in tools:
                    cmd = build_command(tool, row["prompt"], f"<scratch>/{tool}", args.budget, args.live)
                    print(f"{row['id']} {tool} expected={row['expected']}: {shlex.join(cmd)}")
            return 0

        out = Path(args.out)
        date = datetime.date.today().isoformat()
        (out / "raw").mkdir(parents=True, exist_ok=True)

        def work(tool, row):
            try:
                events, raw, note = run_row(tool, row, args)
                (out / "raw" / f"{row['id']}-{tool}.jsonl").write_text(raw, encoding="utf-8")
            except SetupError:
                raise
            except Exception as exc:
                raise SetupError(f"{row['id']} {tool}: {exc!r}")
            got = "error" if note else got_skill(events, tool, row["expected"])
            return {"id": row["id"], "expected": row["expected"], "pair": row["pair"],
                    "got": got, "pass": got == row["expected"], "note": note}

        pool = ThreadPoolExecutor(max_workers=max(1, args.jobs))
        try:
            futures = {tool: [pool.submit(work, tool, row) for row in rows] for tool in tools}
            status = 0
            for tool in tools:
                results, errors = [], []
                for future in futures[tool]:
                    try:
                        results.append(future.result())
                    except SetupError as exc:
                        errors.append(str(exc))
                outcome = report_tool(tool, results, errors, out, date,
                                      merge=bool(args.id or args.skill or args.pair))
                if outcome and (status == 0 or outcome == 2):
                    status = outcome
        except KeyboardInterrupt:
            pool.shutdown(wait=False, cancel_futures=True)
            kill_all()
            print("routing-eval: interrupted", file=sys.stderr)
            return 2
        finally:
            pool.shutdown(wait=True, cancel_futures=True)
        return status
    except SetupError as exc:
        print(f"routing-eval: {exc}", file=sys.stderr)
        return 2


def report_tool(tool, results, errors, out, date, merge=False):
    """Write the TSV and print the verdict. Return 0, 1 or 2."""
    if results:
        write_results(out, tool, results, date, merge)
    for message in errors:
        print(f"routing-eval: {message}", file=sys.stderr)
    if errors:
        return 2
    ok, reasons = threshold(results)
    passed = sum(1 for r in results if r["pass"])
    print(f"{tool}: {'PASS' if ok else 'FAIL'} ({passed}/{len(results)})")
    for r in results:
        if not r["pass"]:
            print(f"  miss {r['id']}: expected {r['expected']}, got {r['got']}" + (f" ({r['note']})" if r.get("note") else ""))
    for reason in reasons:
        print(f"  - {reason}")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
