#!/usr/bin/env python3
"""Rewrite file references from a literal or regex TSV map."""
import argparse
import difflib
import os
import re
import sys
import tempfile
from pathlib import Path


def rewrite_text(text: str, old: str, new: str) -> tuple[str, int]:
    if old.startswith("re:"):
        pattern = re.compile(old[3:])
        pattern.sub(new, "")  # Validate replacement references even without a match.
        changes = 0

        def replace(match: re.Match) -> str:
            nonlocal changes
            replacement = match.expand(new)
            changes += replacement != match[0]
            return replacement

        return pattern.sub(replace, text), changes
    if old == new:
        return text, 0
    return text.replace(old, new), text.count(old)


def replacement_present(text: str, old: str, new: str) -> bool:
    if not old.startswith("re:"):
        return new in text
    source = re.compile(old[3:])
    tokens = re.compile(r"\\(?:0[0-7]{0,2}|[0-7]{3}|g<([^>]+)>|([1-9][0-9]?)|[\s\S])")
    parts = []
    seen = set()
    cursor = 0
    for token in tokens.finditer(new):
        parts.append(re.escape(new[cursor:token.start()]))
        reference = token[1] or token[2]
        if reference is not None:
            number = int(reference) if reference.isdecimal() else source.groupindex[reference]
            name = f"ref_{number}"
            parts.append(f"(?P={name})" if number in seen else f"(?P<{name}>[\\s\\S]*?)")
            seen.add(number)
        else:
            parts.append(re.escape(re.match("", "").expand(token[0])))
        cursor = token.end()
    parts.append(re.escape(new[cursor:]))
    return re.search("".join(parts), text) is not None


def atomic_write(path: Path, text: str) -> None:
    path = path.resolve()
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as staged:
            temporary = Path(staged.name)
            staged.write(text.encode("utf-8"))
        temporary.chmod(path.stat().st_mode & 0o7777)
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def rewrite_files(args: argparse.Namespace) -> int:
    rows = []
    for number, line in enumerate(args.map.read_text(encoding="utf-8").splitlines(), 1):
        if line.count("\t") != 1:
            raise ValueError(f"map row {number} needs old<TAB>new: {line}")
        rows.append(line.split("\t", 1))
    texts = [path.read_bytes().decode("utf-8") for path in args.files]
    originals = texts[:]
    counts = [0] * len(texts)
    for number, (old, new) in enumerate(rows, 1):
        try:
            results = [rewrite_text(text, old, new) for text in texts]
        except (re.error, IndexError) as exc:
            raise ValueError(f"invalid map row {number}: {old}\t{new}: {exc}") from exc
        if not any(changes for _, changes in results) and not any(
                replacement_present(text, old, new) for text in texts):
            print(f"error: map row matches nothing: {old}\t{new}", file=sys.stderr)
            print("fix: check the map row and input files", file=sys.stderr)
            return 1
        texts = [text for text, _ in results]
        counts = [count + changes for count, (_, changes) in zip(counts, results)]
    total = 0
    for path, original, text, count in zip(args.files, originals, texts, counts):
        if count:
            if args.dry_run:
                for line in difflib.unified_diff(
                        original.splitlines(keepends=True), text.splitlines(keepends=True),
                        fromfile=str(path), tofile=str(path)):
                    print(line, end="" if line.endswith("\n") else "\n\\ No newline at end of file\n")
            else:
                atomic_write(path, text)
            print(f"{path}: {count} changes")
        total += count
    print(f"total {total}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="print unified diffs without writes")
    parser.add_argument("map", type=Path, help="TSV map with old and new text")
    parser.add_argument("files", nargs="+", type=Path, help="files to rewrite")
    args = parser.parse_args(argv)
    try:
        return rewrite_files(args)
    except (ValueError, OSError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        print("fix: check the map row and input files", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
