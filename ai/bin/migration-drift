#!/usr/bin/env python3
"""migration-drift: compare a repo's alembic heads with the heads staging reports.

Usage: migration-drift <repo> <staging heads>...

<staging heads> is the text of the staging alembic_version rows (revision ids
separated by whitespace, commas or newlines; extra argv words are joined).
Ids match [A-Za-z0-9_]+. The psql header word version_num, dash rules and
"(N rows)" lines are skipped. For alembic output the first token of each
line counts, and INFO or WARNING log lines are skipped. The user pastes it from a
read-only query. This script never connects to a DB. It only runs
`alembic heads` in <repo>, which reads the revision files.
Prints "in sync", "staging behind: <revs>" or "staging ahead: <revs>".
Exit 0 in sync, 1 drift, 2 setup error (including empty heads on either side).
"""

import re
import subprocess
import sys
from pathlib import Path

ID_RE = re.compile(r"[A-Za-z0-9_]+")
LOG_PREFIXES = ("INFO", "WARNING")


def parse_alembic_heads(text):
    """First token of each non-blank alembic line. Skips INFO and WARNING log lines."""
    revs = set()
    for line in text.splitlines():
        words = line.split()
        if not words or words[0].startswith(LOG_PREFIXES):
            continue
        if ID_RE.fullmatch(words[0]):
            revs.add(words[0])
    return revs


def parse_staging(text):
    """Ids from pasted text. Skips the psql header, dash rules and '(N rows)'."""
    text = re.sub(r"\(.*?\)", " ", text)
    return {
        w for w in text.replace(",", " ").split()
        if w != "version_num" and ID_RE.fullmatch(w)
    }


def repo_heads(repo):
    result = subprocess.run(
        ["alembic", "heads"], cwd=repo, capture_output=True, text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(f"alembic heads failed: {result.stderr.strip()}")
    return parse_alembic_heads(result.stdout)


def main(argv):
    if len(argv) < 3:
        print(__doc__, file=sys.stderr)
        return 2
    repo = Path(argv[1])
    if not repo.is_dir():
        print(f"not a directory: {repo}", file=sys.stderr)
        return 2
    try:
        repo_revs = repo_heads(repo)
    except (OSError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        return 2
    if not repo_revs:
        print("alembic heads printed no revisions", file=sys.stderr)
        return 2
    staging = parse_staging("\n".join(argv[2:]))
    if not staging:
        print("no revision ids found in the staging heads", file=sys.stderr)
        return 2
    behind = sorted(repo_revs - staging)
    ahead = sorted(staging - repo_revs)
    if behind:
        print("staging behind: " + " ".join(behind))
    if ahead:
        print("staging ahead: " + " ".join(ahead))
    if not behind and not ahead:
        print("in sync")
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
